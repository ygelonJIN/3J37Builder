.page{min-height:100vh;background:#1C1B1E}
.loading-wrap{display:flex;flex-direction:column;align-items:center;justify-content:center;height:100vh}
.brand-mark{font-size:36rpx;font-weight:800;letter-spacing:8rpx;color:#E0AE40}
.loading-sub{font-size:22rpx;color:#B09B74;margin-top:16rpx}

/* Stack container - like Flutter Stack */
.stack-container{position:relative;width:100%;height:100vh}

/* Layer 1: Full screen scroll (Positioned.fill) */
.attr-scroll{position:absolute;top:0;left:0;right:0;bottom:0;background:transparent}

/* Layer 2: Cards overlay (Positioned top:0) */
.cards-layer{position:absolute;top:0;left:0;right:0;z-index:10;padding:0 24rpx;pointer-events:none}

/* Layer 3: More button (Positioned bottom:0) */
.more-layer{position:absolute;bottom:40rpx;right:24rpx;z-index:20;display:flex;flex-direction:column;align-items:flex-end}

.card{margin-bottom:10rpx;padding:12rpx 16rpx;background:#241F1A;border:1rpx solid rgba(224,174,64,0.4);border-radius:2rpx;pointer-events:auto}
.card-hdr{display:flex;align-items:center;justify-content:space-between;min-height:32rpx}
.card-summary{font-size:18rpx;font-weight:800;color:#E0AE40;flex:1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;letter-spacing:0.5rpx}
.arrow{font-size:18rpx;color:#B09B74;margin-left:8rpx}
.card-content{margin-top:10rpx}

.pos-row{display:flex;gap:8rpx;margin-bottom:10rpx}
.pos-btn{flex:1;text-align:center;padding:6rpx 0;background:#2D2A24;border:1rpx solid #B09B74;border-radius:2rpx;font-size:18rpx;font-weight:800;color:#B09B74}
.pos-on{background:#E0AE40;color:#241C07;border-color:#E0AE40}

.body-ctrl{display:flex;align-items:center;justify-content:space-between;padding:3rpx 0}
.body-lv{display:flex;align-items:baseline}
.body-lbl{font-size:18rpx;font-weight:500;color:#F2E9D6}
.body-val{font-size:18rpx;font-weight:800;color:#E0AE40}

.pm-ctrl{display:flex;gap:4rpx}
.pm-b{width:48rpx;height:28rpx;display:flex;align-items:center;justify-content:center;background:#2D2A24;border:1rpx solid rgba(224,174,64,0.5);border-radius:2rpx;font-size:20rpx;font-weight:800;color:#E0AE40}
.pm-off{opacity:0.3;border-color:rgba(111,107,96,0.2);color:rgba(111,107,96,0.5)}
.pm-b-sm{width:36rpx;height:24rpx;display:flex;align-items:center;justify-content:center;background:#2D2A24;border:1rpx solid #B09B74;border-radius:2rpx;font-size:18rpx;font-weight:800;color:#F2E9D6}

.ovr-wrap{display:flex;align-items:baseline;gap:4rpx}
.ovr-num{font-size:32rpx;font-weight:800;color:#E0AE40;line-height:1}
.ovr-precise{font-size:14rpx;font-weight:500;color:#6F6B60}
.mm-label{display:flex;align-items:center;gap:4rpx}
.mm-text{font-size:14rpx;font-weight:500;color:#B09B74}
.mm-grid{margin-top:4rpx}
.mm-row{display:flex;gap:3rpx;margin-bottom:2rpx}
.mm-tile{flex:1;display:flex;align-items:center;gap:2rpx;padding:2rpx 6rpx;background:#2D2A24;border:0.5rpx solid rgba(224,174,64,0.15);border-radius:2rpx}
.t-name{font-size:14rpx;font-weight:500;color:#B09B74;flex:1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.t-val{font-size:14rpx;font-weight:700}
.t-cap{font-size:12rpx;font-weight:500;color:#6F6B60}

.goal-title{font-size:22rpx;font-weight:800;color:#B09B74;letter-spacing:4rpx}
.goal-cts{display:flex;gap:8rpx;flex:1;justify-content:flex-end}
.gc{font-size:14rpx;font-weight:700;color:#B09B74}
.add-goal-btn{display:flex;align-items:center;justify-content:center;gap:4rpx;padding:6rpx;background:#2D2A24;border:1rpx solid rgba(224,174,64,0.4);border-radius:2rpx;margin-bottom:8rpx}
.add-icon{font-size:24rpx;font-weight:800;color:#E0AE40}
.add-text{font-size:18rpx;font-weight:700;color:#E0AE40}
.goal-reqs{display:flex;flex-wrap:wrap;gap:4rpx;margin-bottom:6rpx;align-items:center}
.goal-reqs-label{font-size:14rpx;font-weight:800;color:#B09B74}
.goal-req-chip{font-size:14rpx;font-weight:700}
.empty-hint{color:#6F6B60;font-size:18rpx;text-align:center;padding:12rpx}
.goal-item{margin-bottom:4rpx}
.goal-item-row{display:flex;align-items:center;gap:6rpx}
.goal-item-name{flex:1;font-size:16rpx;font-weight:700;color:#B09B74;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.goal-item-tier{font-size:16rpx;font-weight:800}
.goal-item-rm{width:24rpx;height:24rpx;display:flex;align-items:center;justify-content:center;font-size:14rpx;color:#E0AE40}
.goal-vn{font-size:20rpx;font-weight:800;color:#E0AE40;min-width:36rpx;text-align:center}
.goal-cp{font-size:14rpx;color:#6F6B60}

.disc-sec{margin:0 0 4rpx}
.disc-hdr{display:flex;align-items:center;justify-content:space-between;padding:8rpx 24rpx 4rpx}
.disc-nm{font-size:24rpx;font-weight:800}
.disc-st{font-size:22rpx;font-weight:800}

.attr-ctrl{padding:0 24rpx;border-bottom:0.5rpx solid rgba(176,155,116,0.15)}
.attr-row-main{display:flex;align-items:center;padding:10rpx 0}
.attr-exp{width:28rpx;display:flex;align-items:center;justify-content:center}
.exp-ico{font-size:14rpx;color:#B09B74}
.attr-name-wrap{flex:1;padding-right:6rpx}
.attr-nm{font-size:18rpx;font-weight:500;color:#F2E9D6}
.attr-maxed{color:#6F6B60}
.attr-right{display:flex;align-items:center;gap:4rpx}
.goal-lbl{font-size:14rpx;font-weight:900;color:#E0AE40;letter-spacing:2rpx}
.goal-tgt{font-size:14rpx;font-weight:800;color:#E0AE40}

.val-box{display:flex;align-items:center;width:50rpx;height:28rpx;border:1rpx solid rgba(224,174,64,0.3);border-radius:2rpx;background:#2D2A24}
.val-cb{border-color:#E0AE40;border-width:2rpx}
.val-lock{border-color:rgba(111,107,96,0.2)}
.val-inp{width:50rpx;height:24rpx;text-align:center;font-size:18rpx;font-weight:600;color:#E0AE40;background:transparent;border:none}
.val-slash{font-size:16rpx;font-weight:500;color:#6F6B60;margin:0 2rpx}
.val-cap-num{font-size:16rpx;font-weight:500;color:#6F6B60}
.lk-btn{width:32rpx;height:32rpx;display:flex;align-items:center;justify-content:center;font-size:16rpx}

.attr-err{padding:2rpx 28rpx 4rpx}
.attr-err text{font-size:14rpx;font-weight:800;color:#DE574B}

.attr-exp-content{padding:6rpx 0 8rpx 28rpx}
.badge-chips-wrap{display:flex;flex-wrap:wrap;gap:4rpx;margin-bottom:6rpx}
.no-badges-text{font-size:14rpx;color:#6F6B60}
.badge-chip{display:flex;align-items:center;gap:4rpx;padding:3rpx 8rpx;background:#241F1A;border:1rpx solid rgba(176,155,116,0.3);border-radius:2rpx}
.badge-chip-name{font-size:14rpx;font-weight:500;color:#F2E9D6}
.badge-chip-color{width:8rpx;height:8rpx;border-radius:1rpx}

.cb-slots-wrap{margin-top:4rpx}
.cb-slots-header{display:flex;justify-content:space-between;margin-bottom:4rpx}
.cb-slots-title{font-size:14rpx;font-weight:800;color:#B09B74}
.cb-slots-max{font-size:14rpx;font-weight:800;color:#E0AE40}
.cb-slots-row{display:flex;gap:4rpx}
.cb-slot{flex:1;height:20rpx;display:flex;align-items:center;justify-content:center;background:#241F1A;border:1rpx solid rgba(176,155,116,0.3);border-radius:2rpx}
.cb-slot-applied{background:rgba(224,174,64,0.1);border-color:#E0AE40}
.cb-slot-next{border-color:#E0AE40}
.cb-slot-empty{opacity:0.3}
.cb-slot-gain{font-size:12rpx;font-weight:700;color:#E0AE40}

.more-left{display:flex;gap:8rpx;margin-bottom:8rpx}
.more-up{display:flex;flex-direction:column;gap:8rpx;margin-bottom:8rpx;align-items:flex-end}
.mi{padding:8rpx 16rpx;background:#241F1A;border:1rpx solid #B09B74;border-radius:2rpx;font-size:22rpx;font-weight:800;color:#F2E9D6}
.mi-hl{border-color:#E0AE40;color:#E0AE40}
.mi-lang{font-size:18rpx;padding:6rpx 12rpx}
.more-btn{display:flex;align-items:center;gap:6rpx;padding:8rpx 12rpx;background:#2D2A24;border:1rpx solid #B09B74;border-radius:2rpx;font-size:22rpx;font-weight:800;color:#F2E9D6}
.more-btn-on{background:#E0AE40;color:#241C07;border-color:#E0AE40}
.more-arr{font-size:14rpx}

.overlay{position:fixed;top:0;left:0;right:0;bottom:0;background:#1C1B1E;z-index:300;display:flex;flex-direction:column}
.ov-hdr{display:flex;align-items:center;gap:10rpx;padding:16rpx;padding-top:calc(16rpx + env(safe-area-inset-top))}
.pill{padding:6rpx 14rpx;background:#2D2A24;border:1rpx solid #B09B74;border-radius:2rpx;font-size:22rpx;color:#F2E9D6}
.ov-title{font-size:28rpx;font-weight:800;color:#F2E9D6}
.ov-search{padding:0 16rpx 8rpx}
.search-input{background:#241F1A;border:1rpx solid #D8A84E;border-radius:2rpx;padding:8rpx 12rpx;font-size:20rpx;color:#F2E9D6}
.ov-tabs{display:flex;flex-wrap:wrap;gap:6rpx;padding:0 16rpx 8rpx}
.ov-tab{padding:6rpx 14rpx;background:#2D2A24;border:1rpx solid rgba(111,107,96,0.3);border-radius:2rpx;font-size:18rpx;font-weight:800;color:#B09B74}
.ov-tab-on{background:#E0AE40;color:#241C07;border-color:#E0AE40}
.ov-scroll{flex:1;padding:0 16rpx}

.token-budget-row{background:#241F1A;border:1rpx solid rgba(224,174,64,0.4);border-radius:2rpx;padding:12rpx;margin-bottom:12rpx}
.token-total{font-size:28rpx;font-weight:800;color:#E0AE40;display:block;text-align:center;margin-bottom:8rpx}
.token-disc-row{display:flex;justify-content:space-between;padding:3rpx 0}
.token-disc-name{font-size:18rpx;font-weight:800}
.token-disc-val{font-size:16rpx;font-weight:800}

.badge-disc-group{margin-bottom:12rpx}
.badge-disc-hdr{display:flex;justify-content:space-between;padding:6rpx 0;border-bottom:1rpx solid rgba(224,174,64,0.3);margin-bottom:6rpx}
.badge-disc-name{font-size:22rpx;font-weight:800}
.badge-disc-stats{font-size:18rpx;font-weight:800}
.badge-chips-grid{display:flex;flex-wrap:wrap;gap:6rpx}
.badge-panel-chip{display:flex;align-items:center;gap:4rpx;padding:4rpx 10rpx;background:#241F1A;border:1rpx solid rgba(176,155,116,0.3);border-radius:2rpx}
.badge-panel-chip-name{font-size:16rpx;font-weight:500;color:#F2E9D6}
.badge-panel-chip-color{width:8rpx;height:8rpx;border-radius:1rpx}
.badge-equipped{border-width:2rpx}
.badge-locked{opacity:0.3}

.anim-group{margin-bottom:10rpx}
.anim-group-hdr{display:flex;justify-content:space-between;align-items:center;padding:6rpx 0;border-bottom:1rpx solid rgba(176,155,116,0.2)}
.anim-group-name{font-size:20rpx;font-weight:800;color:#F2E9D6}
.anim-list{padding-left:12rpx}
.anim-item{padding:4rpx 0}
.anim-item-name{font-size:18rpx;color:#B09B74}

.build-card{padding:12rpx;background:#2D2A24;border:1rpx solid rgba(224,174,64,0.4);border-radius:2rpx;margin-bottom:8rpx}
.build-hdr{display:flex;justify-content:space-between;margin-bottom:4rpx}
.build-nm{font-size:20rpx;font-weight:800;color:#F2E9D6}
.build-ovr{font-size:24rpx;font-weight:800;color:#E0AE40}
.build-info{display:flex;gap:12rpx;margin-bottom:8rpx}
.build-pos{font-size:18rpx;font-weight:800;color:#B09B74}
.build-body{font-size:18rpx;color:#B09B74}
.build-actions{display:flex;gap:8rpx}
.build-btn{flex:1;text-align:center;padding:6rpx 0;background:#241F1A;border:1rpx solid #B09B74;border-radius:2rpx;font-size:18rpx;font-weight:800;color:#F2E9D6}
.build-del{border-color:#DE574B;color:#DE574B}

.dialog-mask{position:fixed;top:0;left:0;right:0;bottom:0;background:rgba(0,0,0,0.5);z-index:400;display:flex;align-items:center;justify-content:center}
.dialog-box{background:#2D2A24;border:1rpx solid rgba(224,174,64,0.4);border-radius:2rpx;padding:16rpx;width:85%;max-height:70vh;display:flex;flex-direction:column}
.dialog-title{font-size:24rpx;font-weight:800;color:#E0AE40;margin-bottom:12rpx;display:block}
.dialog-tabs{display:flex;gap:4rpx;margin-bottom:10rpx}
.dialog-tab{padding:6rpx 16rpx;background:#241F1A;border:1rpx solid rgba(111,107,96,0.3);border-radius:2rpx;font-size:20rpx;font-weight:800;color:#B09B74}
.dialog-tab-on{background:#E0AE40;color:#241C07;border-color:#E0AE40}
.dialog-search{background:#241F1A;border:1rpx solid #D8A84E;border-radius:2rpx;padding:8rpx 12rpx;font-size:20rpx;color:#F2E9D6;margin-bottom:6rpx}
.dialog-tier-sel{margin-bottom:6rpx}
.tier-sel-btn{display:flex;justify-content:space-between;padding:8rpx 12rpx;background:#241F1A;border:1rpx solid #D8A84E;border-radius:2rpx;font-size:20rpx;color:#F2E9D6}
.tier-dropdown{background:#241F1A;border:1rpx solid #D8A84E;border-radius:2rpx;margin-top:3rpx}
.tier-opt{padding:6rpx 12rpx;font-size:20rpx;color:#F2E9D6;border-bottom:0.5rpx solid rgba(176,155,116,0.15)}
.dialog-val-row{display:flex;align-items:center;gap:6rpx;margin-bottom:6rpx}
.dialog-val-label{font-size:18rpx;color:#B09B74}
.dialog-val-inp{flex:1;background:#241F1A;border:1rpx solid #D8A84E;border-radius:2rpx;padding:6rpx 12rpx;font-size:20rpx;color:#F2E9D6}
.dialog-results{flex:1;max-height:260rpx;margin-bottom:6rpx}
.dialog-item{padding:8rpx 12rpx;border-bottom:0.5rpx solid rgba(176,155,116,0.15);display:flex;justify-content:space-between;align-items:center}
.dialog-item-sel{background:rgba(224,174,64,0.1)}
.dialog-item-name{font-size:20rpx;font-weight:800;color:#F2E9D6}
.dialog-item-sub{font-size:16rpx;color:#B09B74}
.dialog-err{margin-bottom:6rpx}
.dialog-err text{font-size:18rpx;font-weight:800;color:#DE574B}
.dialog-btns{display:flex;justify-content:flex-end;gap:8rpx}
.dialog-btn{padding:8rpx 20rpx;background:#241F1A;border:1rpx solid #B09B74;border-radius:2rpx;font-size:20rpx;font-weight:800;color:#B09B74}
.dialog-btn-primary{background:#E0AE40;color:#241C07;border-color:#E0AE40}

.badge-detail-tiers{display:flex;gap:8rpx;flex-wrap:wrap;margin:12rpx 0}
.tier-btn{padding:4rpx 12rpx;border-radius:2rpx;font-size:16rpx;font-weight:800;border:1rpx solid;opacity:0.5}
.tier-bronze{border-color:#CD7F32;color:#CD7F32;background:rgba(205,127,50,0.1)}
.tier-silver{border-color:#C0C0C0;color:#C0C0C0;background:rgba(192,192,192,0.1)}
.tier-gold{border-color:#E0AE40;color:#E0AE40;background:rgba(224,174,64,0.1)}
.tier-hall_of_fame{border-color:#9B59B6;color:#9B59B6;background:rgba(155,89,182,0.1)}
.tier-legend{border-color:#FF6B6B;color:#FF6B6B;background:rgba(255,107,107,0.1)}
.tier-eq{opacity:1;border-width:2rpx}
.tier-lock{opacity:0.25}
