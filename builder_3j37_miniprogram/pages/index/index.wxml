<view class="page">
  <view wx:if="{{loading}}" class="loading-wrap">
    <text class="brand-mark">3J37 BUILDER</text>
    <text class="loading-sub">{{loadingMsg}}</text>
  </view>

  <block wx:else>
    <!-- Stack container - position:relative, full screen -->
    <view class="stack-container">
      
      <!-- Layer 1: Full screen scroll-view (Positioned.fill) -->
      <scroll-view scroll-y class="attr-scroll"  enhanced show-scrollbar="{{false}}" bindscroll="onScroll">
        <view wx:for="{{discGroups}}" wx:key="d" class="disc-sec">
          <view class="disc-hdr">
            <text class="disc-nm" style="color:{{item.color}}">{{item.name}}</text>
            <text class="disc-st" style="color:{{item.color}}">{{item.tokRem}}/{{item.tokBud}} Tokens {{item.sltRem}}/{{item.sltBud}} Slots</text>
          </view>
          <view wx:for="{{item.attrs}}" wx:for-item="a" wx:key="index" class="attr-ctrl">
            <view class="attr-row-main">
              <view class="attr-exp" data-d="{{item.d}}" data-ai="{{a.index}}" bindtap="toggleAttrExp">
                <text class="exp-ico">{{a.expanded?'▼':'▶'}}</text>
              </view>
              <view class="attr-name-wrap" data-d="{{item.d}}" data-ai="{{a.index}}" bindtap="toggleAttrExp">
                <text class="attr-nm {{a.isMaxed?'attr-maxed':''}}">{{a.name}}</text>
              </view>
              <view class="attr-right">
                <block wx:if="{{a.goalActive}}">
                  <text class="goal-lbl">GOAL</text>
                  <text class="goal-tgt">{{a.goalVal}}{{a.cbGain>0?'+'+a.cbGain:''}}</text>
                </block>
                <block wx:else>
                  <view class="pm-ctrl">
                    <view class="pm-b {{a.value<=25||a.locked?'pm-off':''}}" data-ai="{{a.index}}" data-dir="-1" bindtap="onAttrStep"><text>−</text></view>
                    <view class="pm-b {{a.value>=a.cap||a.locked?'pm-off':''}}" data-ai="{{a.index}}" data-dir="1" bindtap="onAttrStep"><text>+</text></view>
                  </view>
                  <view class="val-box {{a.cbGain>0?'val-cb':''}} {{a.locked?'val-lock':''}}">
                    <input type="number" class="val-inp" value="{{a.value}}" data-ai="{{a.index}}" bindblur="onValBlur" bindconfirm="onValBlur" disabled="{{a.locked}}" />
                  </view>
                  <text class="val-slash">/</text>
                  <text class="val-cap-num">{{a.cap}}</text>
                  <view class="lk-btn" data-ai="{{a.index}}" bindtap="toggleLock"><text>{{a.locked?'🔒':'🔓'}}</text></view>
                </block>
              </view>
            </view>
            <view wx:if="{{a.hasError}}" class="attr-err"><text>{{a.errMsg}}</text></view>
            <view wx:if="{{a.expanded}}" class="attr-exp-content">
              <view class="badge-chips-wrap">
                <view wx:if="{{a.relBadges.length===0}}" class="no-badges-text">No related badges</view>
                <view wx:for="{{a.relBadges}}" wx:for-item="bg" wx:key="id" class="badge-chip" data-bid="{{bg.id}}" bindtap="onBadgeChipTap">
                  <text class="badge-chip-name">{{bg.name}}</text>
                  <view class="badge-chip-color" style="background:{{bg.color}}"></view>
                </view>
              </view>
              <view wx:if="{{a.cbSeq.length>0}}" class="cb-slots-wrap">
                <view class="cb-slots-header">
                  <text class="cb-slots-title">Cap Breakers</text>
                  <text class="cb-slots-max">Hard Cap {{a.cbMaxValue}}</text>
                </view>
                <view class="cb-slots-row">
                  <view wx:for="{{a.cbSlots}}" wx:for-item="slot" wx:key="index"
                    class="cb-slot {{slot.applied?'cb-slot-applied':''}} {{slot.isNext?'cb-slot-next':''}} {{slot.available?'':'cb-slot-empty'}}"
                    data-ai="{{a.index}}" data-si="{{index}}" bindtap="onCBSlotTap">
                    <text class="cb-slot-gain">{{slot.gain!=null?'+'+slot.gain:''}}</text>
                  </view>
                </view>
              </view>
            </view>
          </view>
        </view>
        <view style="height:120rpx"></view>
      </scroll-view>

      <!-- Layer 2: Three cards overlay (Positioned top:0) -->
      <view class="cards-layer" style="padding-top:{{statusBarHeight+8}}px">
        <!-- Card 1: OverallDisplay -->
        <view class="card">
          <view class="card-hdr" data-card="body" bindtap="toggleCard">
            <text class="card-summary">{{posLabel}}  {{heightDisplay}}/{{heightCm}}cm  {{weightLb}}lbs/{{weightKg}}kg  {{wingspanDisplay}}/{{wingspanCm}}cm</text>
            <text class="arrow">{{cardBody?'▲':'▼'}}</text>
          </view>
          <view wx:if="{{cardBody}}" class="card-content">
            <view class="pos-row">
              <view wx:for="{{posList}}" wx:key="code" class="pos-btn {{position===item.code?'pos-on':''}}" data-code="{{item.code}}" bindtap="onPosChange"><text>{{item.label}}</text></view>
            </view>
            <view class="body-ctrl">
              <view class="body-lv"><text class="body-lbl">Height </text><text class="body-val">{{heightDisplay}} / {{heightCm}}cm</text></view>
              <view class="pm-ctrl"><view class="pm-b" bindtap="onBodyStep" data-field="height" data-dir="-1"><text>−</text></view><view class="pm-b" bindtap="onBodyStep" data-field="height" data-dir="1"><text>+</text></view></view>
            </view>
            <view class="body-ctrl">
              <view class="body-lv"><text class="body-lbl">Weight </text><text class="body-val">{{weightLb}} lbs / {{weightKg}}kg</text></view>
              <view class="pm-ctrl"><view class="pm-b" bindtap="onBodyStep" data-field="weight" data-dir="-1"><text>−</text></view><view class="pm-b" bindtap="onBodyStep" data-field="weight" data-dir="1"><text>+</text></view></view>
            </view>
            <view class="body-ctrl">
              <view class="body-lv"><text class="body-lbl">Wingspan </text><text class="body-val">{{wingspanDisplay}} / {{wingspanCm}}cm</text></view>
              <view class="pm-ctrl"><view class="pm-b" bindtap="onBodyStep" data-field="wingspan" data-dir="-1"><text>−</text></view><view class="pm-b" bindtap="onBodyStep" data-field="wingspan" data-dir="1"><text>+</text></view></view>
            </view>
          </view>
        </view>

        <!-- Card 2: GoalCard -->
        <view class="card">
          <view class="card-hdr" data-card="goal" bindtap="toggleCard">
            <text class="goal-title">GOAL</text>
            <view class="goal-cts">
              <text class="gc">Badges:{{goalBadgeCount}}</text>
              <text class="gc">Moves:{{goalMoveCount}}</text>
              <text class="gc">Attr:{{goalAttrCount}}</text>
            </view>
            <text class="arrow">{{cardGoal?'▲':'▼'}}</text>
          </view>
          <view wx:if="{{cardGoal}}" class="card-content">
            <view class="add-goal-btn" bindtap="openAddGoal">
              <text class="add-icon">+</text>
              <text class="add-text">Add Goal</text>
            </view>
            <view wx:if="{{goalAttrReqs.length>0}}" class="goal-reqs">
              <text class="goal-reqs-label">Attr Reqs:</text>
              <text wx:for="{{goalAttrReqs}}" wx:key="index" class="goal-req-chip" style="color:{{item.color}}">{{item.name}} {{item.value}}</text>
            </view>
            <view wx:if="{{goalBadgeCount===0&&goalMoveCount===0&&goalAttrCount===0}}" class="empty-hint">No goals set</view>
            <view wx:for="{{goalBadges}}" wx:key="id" class="goal-item">
              <view class="goal-item-row">
                <text class="goal-item-name">{{item.name}}</text>
                <text class="goal-item-tier" style="color:{{item.tierColor}}">{{item.tier}}</text>
                <view class="goal-item-rm" data-id="{{item.id}}" data-type="badge" bindtap="removeGoalItem"><text>✕</text></view>
              </view>
            </view>
            <view wx:for="{{goalMoves}}" wx:key="id" class="goal-item">
              <view class="goal-item-row">
                <text class="goal-item-name">{{item.name}}</text>
                <view class="goal-item-rm" data-id="{{item.id}}" data-type="move" bindtap="removeGoalItem"><text>✕</text></view>
              </view>
            </view>
            <view wx:for="{{goalAttrs}}" wx:key="index" class="goal-item">
              <view class="goal-item-row">
                <text class="goal-item-name">{{item.name}}</text>
                <view class="pm-ctrl"><view class="pm-b-sm" data-ai="{{item.index}}" data-dir="-1" bindtap="onGoalStep"><text>−</text></view><text class="goal-vn">{{item.value}}</text><view class="pm-b-sm" data-ai="{{item.index}}" data-dir="1" bindtap="onGoalStep"><text>+</text></view></view>
                <text class="goal-cp">/{{item.cap}}</text>
                <view class="goal-item-rm" data-ai="{{item.index}}" data-type="attr" bindtap="removeGoalItem"><text>✕</text></view>
              </view>
            </view>
          </view>
        </view>

        <!-- Card 3: Minimap -->
        <view class="card">
          <view class="card-hdr" data-card="minimap" bindtap="toggleCard">
            <view class="ovr-wrap"><text class="ovr-num">{{overallRating}}</text><text class="ovr-precise">({{ovrPrecise}})</text></view>
            <view class="mm-label"><text class="mm-text">Minimap</text><text class="arrow">{{cardMinimap?'▲':'▼'}}</text></view>
          </view>
          <view wx:if="{{cardMinimap}}" class="mm-grid">
            <view wx:for="{{minimapRows}}" wx:key="index" class="mm-row">
              <view wx:for="{{item}}" wx:for-item="tile" wx:key="idx" class="mm-tile" style="border-color:{{tile.c}}20">
                <text class="t-name" style="color:{{tile.nc}}">{{tile.n}}</text>
                <text class="t-val" style="color:{{tile.vc}}">{{tile.v}}</text>
                <text class="t-cap">/{{tile.cap}}</text>
              </view>
            </view>
          </view>
        </view>
      </view>

      <!-- Layer 3: More button (Positioned bottom:0) -->
      <view class="more-layer">
        <view wx:if="{{moreOpen}}" class="more-left">
          <view class="mi" bindtap="openMoves"><text>Moves</text></view>
          <view class="mi" bindtap="openBadges"><text>Badges</text></view>
        </view>
        <view wx:if="{{moreOpen}}" class="more-up">
          <view class="mi mi-lang" bindtap="toggleLocale"><text>{{locale==='zh_CN'?'EN':'中文'}}</text></view>
          <view class="mi mi-hl" bindtap="openMyB"><text>My Builds</text></view>
          <view class="mi mi-hl" bindtap="saveBuild"><text>Save</text></view>
        </view>
        <view class="more-btn {{moreOpen?'more-btn-on':''}}" bindtap="toggleMore">
          <text>MORE</text><text class="more-arr">▲</text>
        </view>
      </view>
    </view>

    <!-- Badges Overlay -->
    <view wx:if="{{showBadges}}" class="overlay">
      <view class="ov-hdr">
        <view class="pill" bindtap="closeBadges"><text>←</text></view>
        <text class="ov-title">Badges</text>
      </view>
      <view class="ov-search">
        <input class="search-input" placeholder="Search badges..." value="{{badgeSearchQuery}}" bindinput="onBadgeSearch" />
      </view>
      <scroll-view scroll-y class="ov-scroll">
        <view class="token-budget-row">
          <text class="token-total">{{tokenRemaining}}/{{tokenBudget}}</text>
          <view wx:for="{{tokenByDisc}}" wx:key="disc" class="token-disc-row">
            <text class="token-disc-name" style="color:{{item.color}}">{{item.name}}</text>
            <text class="token-disc-val" style="color:{{item.color}}">{{item.remaining}}/{{item.budget}} Tokens {{item.slotRemaining}}/{{item.slotBudget}} Slots</text>
          </view>
        </view>
        <view wx:for="{{filteredBadgeGroups}}" wx:key="disc" class="badge-disc-group">
          <view class="badge-disc-hdr">
            <text class="badge-disc-name" style="color:{{item.color}}">{{item.name}}</text>
            <text class="badge-disc-stats" style="color:{{item.color}}">{{item.tokenRemaining}}/{{item.tokenBudget}} Tokens {{item.slotRemaining}}/{{item.slotBudget}} Slots</text>
          </view>
          <view class="badge-chips-grid">
            <view wx:for="{{item.badges}}" wx:for-item="badge" wx:key="id" class="badge-panel-chip {{badge.equipped?'badge-equipped':''}} {{badge.unlocked?'':'badge-locked'}}" style="border-color:{{badge.borderColor}}" data-bid="{{badge.id}}" bindtap="onBadgeChipTap">
              <text class="badge-panel-chip-name">{{badge.name}}</text>
              <view class="badge-panel-chip-color" style="background:{{badge.tierColor}}"></view>
            </view>
          </view>
        </view>
      </scroll-view>
    </view>

    <!-- Moves Overlay -->
    <view wx:if="{{showMoves}}" class="overlay">
      <view class="ov-hdr">
        <view class="pill" bindtap="closeMoves"><text>←</text></view>
        <text class="ov-title">Moves</text>
      </view>
      <view class="ov-tabs">
        <view wx:for="{{animTabs}}" wx:key="id" class="ov-tab {{selectedAnimTab===index?'ov-tab-on':''}}" data-idx="{{index}}" bindtap="selectAnimTab">
          <text>{{item.name}}</text>
        </view>
      </view>
      <view class="ov-search">
        <input class="search-input" placeholder="Search moves..." value="{{moveSearchQuery}}" bindinput="onMoveSearch" />
      </view>
      <scroll-view scroll-y class="ov-scroll">
        <view wx:if="{{filteredAnimGroups.length===0}}" class="empty-hint">No animations loaded</view>
        <view wx:for="{{filteredAnimGroups}}" wx:key="id" class="anim-group">
          <view class="anim-group-hdr" data-gid="{{item.id}}" bindtap="toggleAnimGroup">
            <text class="anim-group-name">{{item.name}}</text>
            <text class="arrow">{{item.expanded?'▲':'▼'}}</text>
          </view>
          <view wx:if="{{item.expanded}}" class="anim-list">
            <view wx:for="{{item.anims}}" wx:for-item="anim" wx:key="id" class="anim-item" data-id="{{anim.id}}" bindtap="onAnimTap">
              <text class="anim-item-name">{{anim.name}}</text>
            </view>
          </view>
        </view>
      </scroll-view>
    </view>

    <!-- MyB Overlay -->
    <view wx:if="{{showMyB}}" class="overlay">
      <view class="ov-hdr">
        <view class="pill" bindtap="closeMyB"><text>←</text></view>
        <text class="ov-title">My Builds</text>
      </view>
      <scroll-view scroll-y class="ov-scroll">
        <view wx:if="{{savedBuilds.length===0}}" class="empty-hint">No saved builds</view>
        <view wx:for="{{savedBuilds}}" wx:key="id" class="build-card">
          <view class="build-hdr"><text class="build-nm">{{item.name}}</text><text class="build-ovr">OVR {{item.overallRating}}</text></view>
          <view class="build-info"><text class="build-pos">{{item.posLabel}}</text><text class="build-body">{{item.heightDisplay}} / {{item.weightLb}}lbs</text></view>
          <view class="build-actions">
            <view class="build-btn" data-id="{{item.id}}" bindtap="loadBuild"><text>Open</text></view>
            <view class="build-btn build-del" data-id="{{item.id}}" bindtap="deleteBuild"><text>Delete</text></view>
          </view>
        </view>
      </scroll-view>
    </view>

    <!-- Add Goal Dialog -->
    <view wx:if="{{showAddGoal}}" class="dialog-mask" bindtap="closeAddGoal">
      <view class="dialog-box" catchtap>
        <view class="dialog-tabs">
          <view wx:for="{{goalTabs}}" wx:key="index" class="dialog-tab {{goalTabIndex===index?'dialog-tab-on':''}}" data-idx="{{index}}" bindtap="switchGoalTab"><text>{{item}}</text></view>
        </view>
        <input class="dialog-search" placeholder="{{goalTabIndex===0?'Search badges...':goalTabIndex===1?'Search moves...':'Search attributes...'}}" value="{{goalSearchQuery}}" bindinput="onGoalSearch" />
        <view wx:if="{{goalTabIndex===0}}" class="dialog-tier-sel">
          <view class="tier-sel-btn" bindtap="toggleTierDropdown"><text>{{selectedTier?selectedTierLabel:'Select badge tier'}}</text><text>▼</text></view>
          <view wx:if="{{tierDropdownOpen}}" class="tier-dropdown">
            <view wx:for="{{tierOptions}}" wx:key="code" class="tier-opt" data-code="{{item.code}}" data-label="{{item.label}}" bindtap="selectTier"><text>{{item.label}}</text></view>
          </view>
        </view>
        <view wx:if="{{goalTabIndex===2}}" class="dialog-val-row">
          <text class="dialog-val-label">Target value</text>
          <input type="number" class="dialog-val-inp" value="{{goalTargetValue}}" bindinput="onGoalTargetInput" />
        </view>
        <scroll-view scroll-y class="dialog-results">
          <block wx:if="{{goalTabIndex===0}}">
            <view wx:for="{{filteredBadges}}" wx:key="badgeId" class="dialog-item {{goalSelectedId===item.badgeId?'dialog-item-sel':''}}" data-id="{{item.badgeId}}" bindtap="selectGoalBadge">
              <text class="dialog-item-name" style="color:{{item.discColor}}">{{item.name}}</text>
              <text class="dialog-item-sub">{{item.discName}}</text>
            </view>
          </block>
          <block wx:if="{{goalTabIndex===1}}">
            <view wx:for="{{filteredMoves}}" wx:key="id" class="dialog-item {{goalSelectedId===item.id?'dialog-item-sel':''}}" data-id="{{item.id}}" bindtap="selectGoalMove">
              <text class="dialog-item-name">{{item.name}}</text>
            </view>
          </block>
          <block wx:if="{{goalTabIndex===2}}">
            <view wx:for="{{filteredGoalAttrs}}" wx:key="index" class="dialog-item {{goalSelectedAttrIndex===item.index?'dialog-item-sel':''}}" data-ai="{{item.index}}" bindtap="selectGoalAttr">
              <text class="dialog-item-name" style="color:{{item.color}}">{{item.name}}</text>
              <text class="dialog-item-sub">{{item.value}}/{{item.cap}}</text>
            </view>
          </block>
        </scroll-view>
        <view wx:if="{{goalDialogError}}" class="dialog-err"><text>{{goalDialogError}}</text></view>
        <view class="dialog-btns">
          <view class="dialog-btn" bindtap="closeAddGoal"><text>Cancel</text></view>
          <view class="dialog-btn dialog-btn-primary" bindtap="onGoalAdd"><text>Add</text></view>
        </view>
      </view>
    </view>

    <!-- Badge Detail Dialog -->
    <view wx:if="{{showBadgeDetail}}" class="dialog-mask" bindtap="closeBadgeDetail">
      <view class="dialog-box" catchtap>
        <text class="dialog-title">{{badgeDetail.name}}</text>
        <view class="badge-detail-tiers">
          <view wx:for="{{badgeDetail.tiers}}" wx:for-item="tier" wx:key="code"
            class="tier-btn tier-{{tier.key}} {{tier.eq?'tier-eq':''}} {{tier.ul?'':'tier-lock'}}"
            data-bid="{{badgeDetail.id}}" data-tier="{{tier.code}}" bindtap="onToggleBadge">
            <text>{{tier.label}}</text>
          </view>
        </view>
        <view class="dialog-btns">
          <view class="dialog-btn" bindtap="closeBadgeDetail"><text>Close</text></view>
        </view>
      </view>
    </view>
  </block>
</view>
