<view class="page">
  <view class="hdr">
    <view class="back-btn" bindtap="goBack"><text>←</text></view>
    <text class="title">My Builds</text>
  </view>
  <view wx:if="{{builds.length===0}}" class="empty">
    <text class="empty-icon">📋</text>
    <text class="empty-t">No Saved Builds</text>
    <text class="empty-d">Save a build to see it here</text>
  </view>
  <scroll-view wx:else scroll-y class="build-list">
    <view wx:for="{{builds}}" wx:key="id" class="build-card">
      <view class="build-hdr">
        <text class="build-nm">{{item.name}}</text>
        <text class="build-ovr">OVR {{item.overallRating}}</text>
      </view>
      <view class="build-info">
        <text class="build-pos">{{item.posLabel}}</text>
        <text class="build-body">{{item.heightDisplay}} / {{item.weightLb}}lbs</text>
      </view>
      <view class="build-actions">
        <view class="build-btn" data-id="{{item.id}}" bindtap="loadBuild"><text>Open</text></view>
        <view class="build-btn build-del" data-id="{{item.id}}" bindtap="deleteBuild"><text>Delete</text></view>
      </view>
    </view>
  </scroll-view>
</view>
