.page{min-height:100vh;background:#1C1B1E}
.hdr{display:flex;align-items:center;gap:12rpx;padding:24rpx;padding-top:calc(24rpx + env(safe-area-inset-top))}
.back-btn{padding:8rpx 20rpx;background:#2D2A24;border:1rpx solid #B09B74;border-radius:2rpx;font-size:26rpx;color:#F2E9D6}
.title{font-size:32rpx;font-weight:800;color:#E0AE40}
.empty{display:flex;flex-direction:column;align-items:center;justify-content:center;padding:120rpx 0}
.empty-icon{font-size:64rpx;margin-bottom:16rpx}
.empty-t{color:#F2E9D6;font-size:28rpx;font-weight:800;margin-bottom:8rpx}
.empty-d{color:#B09B74;font-size:24rpx}
.build-list{height:calc(100vh - 100rpx);padding:0 24rpx}
.build-card{padding:16rpx;background:#2D2A24;border:1rpx solid rgba(224,174,64,0.4);border-radius:2rpx;margin-bottom:12rpx}
.build-hdr{display:flex;justify-content:space-between;margin-bottom:8rpx}
.build-nm{font-size:24rpx;font-weight:800;color:#F2E9D6}
.build-ovr{font-size:28rpx;font-weight:800;color:#E0AE40}
.build-info{display:flex;gap:16rpx;margin-bottom:12rpx}
.build-pos{font-size:22rpx;font-weight:800;color:#B09B74}
.build-body{font-size:22rpx;color:#B09B74}
.build-actions{display:flex;gap:12rpx}
.build-btn{flex:1;text-align:center;padding:10rpx 0;background:#241F1A;border:1rpx solid #B09B74;border-radius:2rpx;font-size:22rpx;font-weight:800;color:#F2E9D6}
.build-del{border-color:#DE574B;color:#DE574B}
